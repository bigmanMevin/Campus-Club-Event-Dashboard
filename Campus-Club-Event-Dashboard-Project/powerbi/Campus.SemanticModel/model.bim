{
  "name": "CampusEvents",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "Events",
        "columns": [
          {
            "name": "Event_ID",
            "dataType": "string",
            "sourceColumn": "Event_ID",
            "summarizeBy": "none"
          },
          {
            "name": "Event_Name",
            "dataType": "string",
            "sourceColumn": "Event_Name",
            "summarizeBy": "none"
          },
          {
            "name": "Club",
            "dataType": "string",
            "sourceColumn": "Club",
            "summarizeBy": "none"
          },
          {
            "name": "Category",
            "dataType": "string",
            "sourceColumn": "Category",
            "summarizeBy": "none"
          },
          {
            "name": "Event_Date",
            "dataType": "dateTime",
            "sourceColumn": "Event_Date",
            "summarizeBy": "none",
            "formatString": "dd MMM yyyy"
          },
          {
            "name": "Registrations",
            "dataType": "int64",
            "sourceColumn": "Registrations",
            "summarizeBy": "sum"
          },
          {
            "name": "Attendees",
            "dataType": "int64",
            "sourceColumn": "Attendees",
            "summarizeBy": "sum"
          },
          {
            "name": "Budget_AED",
            "dataType": "int64",
            "sourceColumn": "Budget_AED",
            "summarizeBy": "sum"
          },
          {
            "name": "Actual_Cost_AED",
            "dataType": "int64",
            "sourceColumn": "Actual_Cost_AED",
            "summarizeBy": "sum"
          },
          {
            "name": "Feedback_Responses",
            "dataType": "int64",
            "sourceColumn": "Feedback_Responses",
            "summarizeBy": "sum"
          },
          {
            "name": "Feedback_Points",
            "dataType": "int64",
            "sourceColumn": "Feedback_Points",
            "summarizeBy": "sum"
          }
        ],
        "measures": [
          {
            "name": "Total Events",
            "expression": "DISTINCTCOUNT(Events[Event_ID])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Active Clubs",
            "expression": "DISTINCTCOUNT(Events[Club])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Total Registrations",
            "expression": "SUM(Events[Registrations])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Total Attendance",
            "expression": "SUM(Events[Attendees])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Attendance Rate",
            "expression": "DIVIDE([Total Attendance], [Total Registrations])",
            "formatString": "0.0%",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Total Budget",
            "expression": "SUM(Events[Budget_AED])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Total Spend",
            "expression": "SUM(Events[Actual_Cost_AED])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Budget Remaining",
            "expression": "[Total Budget] - [Total Spend]",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Feedback Responses",
            "expression": "SUM(Events[Feedback_Responses])",
            "formatString": "#,0",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Average Feedback",
            "expression": "DIVIDE(SUM(Events[Feedback_Points]), [Feedback Responses])",
            "formatString": "0.00",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Feedback Response Rate",
            "expression": "DIVIDE([Feedback Responses], [Total Attendance])",
            "formatString": "0.0%",
            "displayFolder": "Event metrics"
          },
          {
            "name": "Cost per Attendance",
            "expression": "DIVIDE([Total Spend], [Total Attendance])",
            "formatString": "0.00",
            "displayFolder": "Event metrics"
          }
        ],
        "partitions": [
          {
            "name": "Events",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(Binary.FromText(\"\", BinaryEncoding.Base64), [Delimiter=\",\", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    CleanLabels = Table.TransformColumns(Headers, {{\"Club\", Text.Trim, type text}, {\"Category\", each Text.Proper(Text.Trim(_)), type text}}),",
                "    Deduplicated = Table.Distinct(CleanLabels, {\"Event_ID\"}),",
                "    Typed = Table.TransformColumnTypes(Deduplicated, {{\"Event_ID\", type text}, {\"Event_Name\", type text}, {\"Club\", type text}, {\"Category\", type text}, {\"Event_Date\", type date}, {\"Registrations\", Int64.Type}, {\"Attendees\", Int64.Type}, {\"Budget_AED\", Int64.Type}, {\"Actual_Cost_AED\", Int64.Type}, {\"Feedback_Responses\", Int64.Type}, {\"Feedback_Points\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      }
    ]
  }
}